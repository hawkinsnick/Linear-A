{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linear A Research API response v1",
  "type": "object",
  "required": [
    "api_version",
    "resource",
    "records"
  ],
  "properties": {
    "api_version": {
      "const": "1.0"
    },
    "resource": {
      "enum": [
        "documents",
        "signs",
        "source_words",
        "contexts",
        "sites",
        "evidence",
        "witness_assertions",
        "disagreements",
        "bibliography",
        "claims",
        "experiments"
      ]
    },
    "records": {
      "type": "array"
    },
    "provenance": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "query": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        },
        "filters": {
          "type": "object"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "additionalProperties": false
    },
    "rights": {
      "type": "object"
    },
    "lineage": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
