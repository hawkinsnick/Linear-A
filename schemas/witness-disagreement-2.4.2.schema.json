{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linear A witness disagreement 2.4.2",
  "type": "object",
  "required": [
    "disagreement_id",
    "canonical_document_id",
    "assertion_type",
    "assertion_ids",
    "classification",
    "adjudication_status"
  ],
  "properties": {
    "disagreement_id": {
      "type": "string"
    },
    "canonical_document_id": {
      "type": "string"
    },
    "locus": {
      "type": [
        "string",
        "null"
      ]
    },
    "assertion_type": {
      "type": "string"
    },
    "assertion_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "classification": {
      "enum": [
        "notation_only",
        "segmentation",
        "sign_identity",
        "numeral_value",
        "fraction_value",
        "damage_state",
        "metadata",
        "layout",
        "unresolved_other"
      ]
    },
    "independence_summary": {
      "enum": [
        "independent_epigraphic",
        "partially_independent",
        "shared_upstream_only",
        "mixed",
        "unknown"
      ]
    },
    "adjudication_status": {
      "enum": [
        "open",
        "provisional",
        "resolved_to_source",
        "resolved_to_primary_object",
        "not_resolvable"
      ]
    },
    "resolution_assertion_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
