{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linear A evidence instance 2.4.1",
  "type": "object",
  "required": [
    "evidence_id",
    "document_id",
    "evidence_type",
    "source_id",
    "source_record",
    "license_status"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "evidence_type": {
      "enum": [
        "sign_instance",
        "reading",
        "word_membership",
        "scribe_attribution",
        "support",
        "period",
        "site",
        "find_area",
        "find_spot",
        "side",
        "region",
        "line",
        "separator",
        "damage",
        "erasure",
        "layout",
        "image_reference",
        "tracing_reference"
      ]
    },
    "sign_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurrence_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "value": {},
    "certainty": {
      "enum": [
        "certain",
        "probable",
        "uncertain",
        "unknown",
        "not_applicable"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "source_record": {
      "type": "string"
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "lineage_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "license_status": {
      "type": "string"
    },
    "redistributable": {
      "type": "boolean"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
